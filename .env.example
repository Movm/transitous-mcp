MCP_TRANSPORT=http
PORT=3000

# Required for API calls. Transitous requires app name, version, and contact.
TRANSITOUS_USER_AGENT=transitous-mcp/0.2.0 (https://github.com/YOUR_USER/transitous-mcp; mailto:you@example.com)

# Optional: protect /mcp with Authorization: Bearer <value> or X-API-Key.
MCP_API_KEY=replace-with-a-long-random-secret

# Optional, comma-separated. Origin filtering is defense-in-depth, not authentication.
MCP_ALLOWED_ORIGINS=https://chatgpt.com,https://claude.ai

TRANSITOUS_BASE_URL=https://api.transitous.org
TRANSITOUS_REQUESTS_PER_MINUTE=20
MCP_REQUESTS_PER_MINUTE=60
